// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  manager
  employee
}

model Employee {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  passwordHash     String
  role             Role      @default(employee)
  gender           String?
  dob              DateTime?
  homeWorkDistance Decimal?  @db.Decimal(8, 2)
  xp               Int       @default(0)
  points           Int       @default(0)
  status           String    @default("active")

  departmentId Int?
  department   Department? @relation("DeptEmployees", fields: [departmentId], references: [id])

  headOfDepartments Department[]   @relation("DepartmentHead")
  notifications     Notification[]

  // Phase 1 — operational records
  expenseRecords   ExpenseRecord[]
  fleetVehicles    FleetVehicle[]
  businessTravels  BusinessTravel[]
  payrollContracts PayrollContract[]

  // Phase 3 — Environmental pillar
  assignedInitiatives Initiative[] @relation("InitiativeAssignee")

  // Phase 3 — Social + Gamification
  participations          EmployeeParticipation[]
  challengeParticipations ChallengeParticipation[]
  employeeBadges          EmployeeBadge[]
  rewardRedemptions       RewardRedemption[]
}

model Department {
  id            Int    @id @default(autoincrement())
  name          String
  code          String @unique
  status        String @default("active")
  employeeCount Int    @default(0)

  parentId Int?
  parent   Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DeptHierarchy")

  headEmployeeId Int?
  headEmployee   Employee? @relation("DepartmentHead", fields: [headEmployeeId], references: [id])

  employees        Employee[]        @relation("DeptEmployees")
  emittedEmissions EmittedEmission[]

  // Phase 3 — Environmental pillar
  environmentalGoals EnvironmentalGoal[]
  initiatives        Initiative[]
  csrActivities      CsrActivity[]
}

model Category {
  id     Int    @id @default(autoincrement())
  name   String
  type   String
  status String @default("active")

  // Phase 3 — Social + Gamification
  csrActivities CsrActivity[]
  challenges    Challenge[]
}

model EsgConfig {
  key   String @id
  value Json
}

model Notification {
  id         Int       @id @default(autoincrement())
  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  type       String
  channel    String    @default("in_app")
  payload    Json?
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model Gas {
  id        Int     @id @default(autoincrement())
  name      String
  symbol    String  @unique
  gwp       Decimal @db.Decimal(10, 2)
  gwpMetric String  @default("AR5")

  gasLines EmissionFactorGasLine[]
}

model EmissionScope {
  id   Int    @id @default(autoincrement())
  name String
  code String @unique

  parentId Int?
  parent   EmissionScope?  @relation("ScopeHierarchy", fields: [parentId], references: [id])
  children EmissionScope[] @relation("ScopeHierarchy")

  emissionFactors EmissionFactor[]
}

model SourceDatabase {
  id             Int       @id @default(autoincrement())
  name           String
  provider       String?
  url            String?
  lastImportedAt DateTime?

  emissionFactors EmissionFactor[]
}

enum ComputeMethod {
  physical
  monetary
}

model EmissionFactor {
  id            Int           @id @default(autoincrement())
  name          String
  uncertainty   Decimal?      @db.Decimal(5, 2)
  computeMethod ComputeMethod
  unitOfMeasure String
  status        String        @default("active")
  value         Decimal       @default(0) @db.Decimal(18, 4)

  scopeId Int
  scope   EmissionScope @relation(fields: [scopeId], references: [id])

  sourceDatabaseId Int
  sourceDatabase   SourceDatabase @relation(fields: [sourceDatabaseId], references: [id])

  gasLines         EmissionFactorGasLine[]
  emittedEmissions EmittedEmission[]
  assignationRules AssignationRule[]
}

model EmissionFactorGasLine {
  id           Int     @id @default(autoincrement())
  activityType String?
  value        Decimal @db.Decimal(18, 4)
  unit         String

  emissionFactorId Int
  emissionFactor   EmissionFactor @relation(fields: [emissionFactorId], references: [id], onDelete: Cascade)

  gasId Int
  gas   Gas @relation(fields: [gasId], references: [id])
}

enum EmissionSourceType {
  accounting
  fleet_commuting
  manual
}

model EmittedEmission {
  id          Int                @id @default(autoincrement())
  name        String
  sourceType  EmissionSourceType @default(manual)
  sourceRefId Int?
  employeeId  Int?
  quantity    Decimal            @db.Decimal(18, 4)
  co2eValue   Decimal            @db.Decimal(18, 4)
  periodStart DateTime?
  periodEnd   DateTime?
  date        DateTime
  evidenceUrl String?
  createdAt   DateTime           @default(now())

  // Nullable: accounting-sourced (Path A) emissions from an Invoice have no
  // department (invoices are vendor-wide, not attributed to a department).
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Nullable: fleet-commuting (Path B) emissions compute directly from
  // FleetVehicleModel.co2Emissions and have no EmissionFactor to point to.
  emissionFactorId Int?
  emissionFactor   EmissionFactor? @relation(fields: [emissionFactorId], references: [id])
}

// Resolves a Phase 1 accounting record (by product/partner/account) to the
// EmissionFactor that should be used for Path A auto-calc. Priority at match
// time: product > partner > account, then most-attributes-matched, then
// newest rule (see AssignationMatchService).
model AssignationRule {
  id                     Int       @id @default(autoincrement())
  productId              Int?
  product                Product?  @relation(fields: [productId], references: [id])
  partnerId              Int?
  partner                Partner?  @relation(fields: [partnerId], references: [id])
  accountId              Int?
  account                Account?  @relation(fields: [accountId], references: [id])
  applicationPeriodStart DateTime?
  applicationPeriodEnd   DateTime?
  replaceExisting        Boolean   @default(false)
  createdAt              DateTime  @default(now())

  emissionFactorId Int
  emissionFactor   EmissionFactor @relation(fields: [emissionFactorId], references: [id])
}

/// ============================================================================
/// PHASE 1 — OPERATIONAL RECORDS (the emission inputs)
///
/// The standalone "mini-ERP" data-entry layer. These models give the Phase 2
/// emission engine authentic inputs. Employee references are real foreign keys
/// to the Phase 0 `Employee` model.
/// ============================================================================

// Purchasable good or service. `uom` is a controlled vocabulary — physical
// emission factors must match it, so it is validated at the DTO layer.
model Product {
  id               Int      @id @default(autoincrement())
  name             String
  code             String   @unique
  uom              String // kWh | L | km | kg | unit | ream | m3 | ...
  defaultAccountId Int?
  defaultAccount   Account? @relation(fields: [defaultAccountId], references: [id])
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invoiceLines     InvoiceLine[]
  expenseRecords   ExpenseRecord[]
  assignationRules AssignationRule[]

  @@map("products")
}

// Vendor / customer. Monetary and physical activity is attributed to a partner.
model Partner {
  id        Int      @id @default(autoincrement())
  name      String
  type      String // vendor | customer | both
  email     String?
  phone     String?
  address   String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices         Invoice[]
  assignationRules AssignationRule[]

  @@map("partners")
}

// Chart-of-accounts entry — what monetary assignation rules attach to.
model Account {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  type      String // expense | asset | liability | income | equity
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products         Product[]
  invoiceLines     InvoiceLine[]
  expenseRecords   ExpenseRecord[]
  assignationRules AssignationRule[]

  @@map("accounts")
}

// Purchase / vendor bill. Posting an invoice is the trigger event for the
// Phase 2 accounting (Path A) capture path.
model Invoice {
  id          Int       @id @default(autoincrement())
  partnerId   Int
  partner     Partner   @relation(fields: [partnerId], references: [id])
  date        DateTime
  currency    String    @default("INR")
  status      String    @default("draft") // draft | posted
  totalAmount Decimal   @default(0) @db.Decimal(14, 2)
  postedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines InvoiceLine[]

  @@map("invoices")
}

model InvoiceLine {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id])
  accountId   Int
  account     Account  @relation(fields: [accountId], references: [id])
  description String?
  quantity    Decimal  @db.Decimal(12, 4)
  uom         String
  unitPrice   Decimal  @db.Decimal(14, 4)
  amount      Decimal  @db.Decimal(14, 2) // enforced = quantity * unitPrice

  @@map("invoice_lines")
}

// Employee-submitted expense — same posting semantics as an invoice line, with
// a manager approval step in front. `employeeId` is a loose FK to Phase 0.
model ExpenseRecord {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id])
  date        DateTime
  accountId   Int?
  account     Account?  @relation(fields: [accountId], references: [id])
  productId   Int?
  product     Product?  @relation(fields: [productId], references: [id])
  description String?
  quantity    Decimal?  @db.Decimal(12, 4)
  uom         String?
  amount      Decimal   @db.Decimal(14, 2)
  // draft | submitted | approved | rejected | posted
  status      String    @default("draft")
  postedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("expense_records")
}

// Fleet ‣ Configuration ‣ Models — CO2 emissions per vehicle model (kgCO2e/km).
model FleetVehicleModel {
  id           Int      @id @default(autoincrement())
  name         String
  co2Emissions Decimal  @db.Decimal(10, 4) // kgCO2e per km
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles FleetVehicle[]

  @@map("fleet_vehicle_models")
}

// An employee's assigned vehicle. Only one may be active (endDate null) per
// employee at a time — enforced in the service layer.
model FleetVehicle {
  id         Int               @id @default(autoincrement())
  employeeId Int
  employee   Employee          @relation(fields: [employeeId], references: [id])
  modelId    Int
  model      FleetVehicleModel @relation(fields: [modelId], references: [id])
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@map("fleet_vehicles")
}

// One-off employee travel — feeds Scope 3 Cat 6 via a factor pick in Phase 2.
model BusinessTravel {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id])
  mode        String // flight | train | car | bus
  origin      String?
  destination String?
  distanceKm  Decimal? @db.Decimal(10, 2)
  date        DateTime
  purpose     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("business_travels")
}

// Payroll contract data needed for the pay-gap formula (same job, by gender).
model PayrollContract {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  employee        Employee  @relation(fields: [employeeId], references: [id])
  jobPosition     String
  contractType    String // permanent | temporary | intern | contract
  leadershipLevel String? // management | non_management | administrative
  country         String?
  wage            Decimal   @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("payroll_contracts")
}

/// ==============================
/// PHASE 3 — ENVIRONMENTAL PILLAR
/// ==============================

// A target metric value with a deadline (e.g. "reduce Scope 2 by 10%").
model EnvironmentalGoal {
  id           Int         @id @default(autoincrement())
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  metric       String
  targetValue  Decimal     @db.Decimal(12, 2)
  unit         String
  startDate    DateTime
  endDate      DateTime
  status       String      @default("active") // active | achieved | missed | archived
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("environmental_goals")
}

// A concrete reduction action with estimated vs actual CO2 saved. Does not
// affect the emission footprint until realized.
model Initiative {
  id                    Int         @id @default(autoincrement())
  title                 String
  description           String?
  departmentId          Int?
  department            Department? @relation(fields: [departmentId], references: [id])
  assigneeEmployeeId    Int?
  assigneeEmployee      Employee?   @relation("InitiativeAssignee", fields: [assigneeEmployeeId], references: [id])
  estimatedCo2Reduction Decimal?    @db.Decimal(12, 2)
  actualCo2Reduction    Decimal?    @db.Decimal(12, 2)
  progress              Decimal     @default(0) @db.Decimal(5, 2)
  deadline              DateTime?
  status                String      @default("open") // open | in_progress | completed | cancelled
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("initiatives")
}

/// ==============================
/// PHASE 3 — SOCIAL + GAMIFICATION
/// ==============================

// A company-organized social initiative employees participate in.
model CsrActivity {
  id           Int         @id @default(autoincrement())
  title        String
  description  String?
  categoryId   Int?
  category     Category?   @relation(fields: [categoryId], references: [id])
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  points       Int         @default(0) // points awarded on approved participation
  startDate    DateTime?
  endDate      DateTime?
  status       String      @default("draft") // draft | active | completed | archived
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  participations EmployeeParticipation[]

  @@map("csr_activities")
}

model EmployeeParticipation {
  id             Int         @id @default(autoincrement())
  employeeId     Int
  employee       Employee    @relation(fields: [employeeId], references: [id])
  csrActivityId  Int
  csrActivity    CsrActivity @relation(fields: [csrActivityId], references: [id], onDelete: Cascade)
  proofUrl       String?
  approvalStatus String      @default("pending") // pending | approved | rejected
  pointsEarned   Int         @default(0)
  completionDate DateTime?
  createdAt      DateTime    @default(now())

  @@unique([employeeId, csrActivityId])
  @@map("employee_participations")
}

// A gamified sustainability task that awards XP through a review lifecycle.
model Challenge {
  id               Int       @id @default(autoincrement())
  title            String
  description      String?
  categoryId       Int?
  category         Category? @relation(fields: [categoryId], references: [id])
  xp               Int       @default(0)
  difficulty       String? // easy | medium | hard
  evidenceRequired Boolean   @default(false)
  deadline         DateTime?
  status           String    @default("draft") // draft | active | under_review | completed | archived
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  participations ChallengeParticipation[]

  @@map("challenges")
}

model ChallengeParticipation {
  id             Int       @id @default(autoincrement())
  challengeId    Int
  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  employeeId     Int
  employee       Employee  @relation(fields: [employeeId], references: [id])
  progress       Decimal   @default(0) @db.Decimal(5, 2)
  proofUrl       String?
  approvalStatus String    @default("pending") // pending | approved | rejected
  xpAwarded      Int       @default(0)
  createdAt      DateTime  @default(now())

  @@unique([challengeId, employeeId])
  @@map("challenge_participations")
}

// An achievement auto-awarded when its unlockRule predicate is satisfied.
model Badge {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  unlockRule  Json // e.g. { "type": "xp", "threshold": 100 }
  icon        String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employeeBadges EmployeeBadge[]

  @@map("badges")
}

model EmployeeBadge {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  badgeId    Int
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  status     String   @default("awarded") // awarded | pending (manual award queue)
  awardedAt  DateTime @default(now())

  @@unique([employeeId, badgeId])
  @@map("employee_badges")
}

// A catalog item redeemable with an employee's spendable points.
model Reward {
  id             Int      @id @default(autoincrement())
  name           String
  description    String?
  pointsRequired Int
  stock          Int      @default(0)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  redemptions RewardRedemption[]

  @@map("rewards")
}

model RewardRedemption {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  employee       Employee @relation(fields: [employeeId], references: [id])
  rewardId       Int
  reward         Reward   @relation(fields: [rewardId], references: [id])
  pointsDeducted Int
  status         String   @default("confirmed")
  redeemedAt     DateTime @default(now())

  @@map("reward_redemptions")
}
